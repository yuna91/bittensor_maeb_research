# /etc/beam/beam.env — SN105 Beam node configuration
# Contains API keys. chmod 640, owner root, group beam.

# ---------- Shared ----------
CORE_SERVER_URL=https://beamcore.b1m.ai
BEAM_PUBLIC_API_URL=https://beamcore.b1m.ai
BEAM_ENV=prod
SUBTENSOR_NETWORK=finney
NETUID=105

# ---------- Orchestrator ----------
# Filled in by 03-register-orchestrator.sh
BEAM_BITTENSOR_HOTKEY=REPLACE_hotkey_ss58
BEAM_ORCHESTRATOR_ID=REPLACE_orchestrator_id

# Your on-chain UID, from `btcli wallet overview --netuid 105`. Not used by the services -
# 06-check-penalty.sh needs it for /orchestrators/prism-scores/<uid>, the authoritative PRISM
# breakdown. Left empty, that query is skipped and penalties can only be inferred.
BEAM_UID=REPLACE_uid

BEAMCORE_NATS_URL=tls://orch-gateway.b1m.ai:4222
BEAMCORE_NATS_USER=REPLACE_hotkey_ss58
BEAMCORE_NATS_PASSWORD=REPLACE_orchestrator_api_key

# MUST be your PUBLIC ip. Loopback here means you never receive work.
BEAMCORE_GATEWAY_URL=http://REPLACE_PUBLIC_IP:8782

BEAM_WCP_LISTEN_ADDR=0.0.0.0:8782
BEAM_WCP_TLS_CERT=/etc/beam/wcp.crt
BEAM_WCP_TLS_KEY=/etc/beam/wcp.key

BEAM_ROOM_TUNNEL_COORDINATOR_URL=https://coordinator.b1m.ai

# ---------- Worker ----------
# Filled in by 04-register-worker.sh
BEAM_WORKER_ID=REPLACE_worker_id

# Internal hop to the co-located orchestrator. Loopback is CORRECT here — unlike
# BEAMCORE_GATEWAY_URL above. The two are often confused.
BEAM_WCP_ADDRESS=127.0.0.1:8782
BEAM_WCP_CA=/etc/beam/wcp.crt
BEAM_WCP_SERVER_NAME=beam-orch

# Only if the membership response returned one:
# BEAM_ORCHESTRATOR_DELEGATION=

# ---------- Worker resource limits ----------
# memory caps concurrent chunks: 2 GiB / 40 MiB per chunk = ~50 in flight.
# Sized for a 4 GB host; raise with RAM, leaving room for the OS and orchestrator.
BEAM_WORKER_MEMORY_BYTES=2147483648
BEAM_WORKER_SCRATCH_BYTES=17179869184
# Start conservative and raise only once you are consistently saturating it.
# Over-claiming pulls in undeliverable work and craters reliability (60% of performance_score).
BEAM_WORKER_BANDWIDTH_MBPS=500

# The orchestrator advertises Room eligibility only when its workers expose BOTH
# room.transfer.direct.v1 and room.transfer.e2ee.v2. Room work is extra uploaded MiB —
# which is exactly what sets your emission rank. Do not drop these.
BEAM_WORKER_CAPABILITIES=transfer.multipart,transfer.multipart.fanout.v1,room.transfer,room.transfer.direct.v1,room.transfer.e2ee.v2

# ---------- Room transfers ----------
# The default room listener is 127.0.0.1:0 (loopback, unusable externally). Binding publicly
# ALSO requires --allow-public-network-listeners on the worker, which defaults to false and
# gates the room handler entirely. Both are set in the systemd unit.
# Open 9470/tcp in the firewall.
BEAM_ROOM_TRANSFER_LISTEN_ADDR=0.0.0.0:9470
BEAM_ROOM_TRANSFER_ADVERTISE_URL=https://REPLACE_PUBLIC_IP:9470
